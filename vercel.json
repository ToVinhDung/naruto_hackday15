{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "antigravity-vibecode-system",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "src",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Antigravity-Engine",
          "value": "PowerBatch-v1.0"
        }
      ]
    }
  ],
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}

