{
  "name": "my-vibecode-app",
  "version": "1.0.0",
  "description": "Hệ thống Vibe Coding chuẩn hóa cho Google Antigravity, tích hợp PowerBatch Orchestrator, Vercel Cloud Pipeline và White UI Design System",
  "type": "module",
  "scripts": {
    "dev": "node src/server.mjs",
    "test": "node --test tests/system.test.mjs",
    "powerbatch": "node .antigravity/powerbatch.mjs verify",
    "verify:guardrails": "node .antigravity/powerbatch.mjs audit-guardrails",
    "verify:ui": "node .antigravity/powerbatch.mjs verify-ui-tokens",
    "verify:vercel": "node .antigravity/powerbatch.mjs verify-vercel",
    "build": "node .antigravity/powerbatch.mjs verify"
  },
  "keywords": [
    "antigravity",
    "vibecoding",
    "powerbatch",
    "vercel",
    "white-ui"
  ],
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^18.0.10",
    "hardhat": "^2.28.0"
  }
}
